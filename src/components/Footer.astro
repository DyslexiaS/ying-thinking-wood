---
import { siteConfig } from '@/site-config'

const today = new Date()
---

<footer
	class='flex justify-center items-center w-full px-16 h-28 text-center text-sm uppercase tracking-widest'
	style='border-top: 1px solid var(--border); color: var(--text-muted);'
>
	{siteConfig.author} &copy; {today.getFullYear()}
</footer>
